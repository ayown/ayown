# Mark README and other markdown docs as documentation so Linguist ignores them
README.md linguist-documentation
docs/** linguist-documentation

# Mark GitHub metadata and workflow files as vendored/ignored for language stats
.github/** linguist-vendored

# If you have build artifacts or generated files, mark them too
# build/** linguist-generated
# vendor/** linguist-vendored

# --- Optional: Force a language for the whole repo ---
# WARNING: Only use this if you understand it will tell GitHub to treat all files as that language.
# Uncomment one of the following lines to force a language (example: Python).
# * linguist-language=Python

# --- Optional: Force a language for a specific folder/pattern ---
# Useful if you add source files under src/ but want to ensure they are counted as a specific language.
# src/** linguist-language=Python
